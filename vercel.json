{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/health", "dest": "api/index.ts" },
    { "src": "/api/(.*)", "dest": "api/index.ts" }
  ]
}
